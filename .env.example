# Провайдер модели: aitunnel (любой OpenAI-совместимый API) или gigachat.
# Ключи удобнее ввести в интерфейсе — они сохранятся в .polymcp/secrets.env и будут главнее этого файла.
POLYMCP_PROVIDER=aitunnel

# aitunnel
AITUNNEL_API_KEY=your_aitunnel_key
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1/

# GigaChat (developers.sber.ru → GigaChat API → «Получить ключ» → Authorization key)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Если не проходит проверка TLS: путь к корневому сертификату НУЦ Минцифры (gosuslugi.ru/crt)
GIGACHAT_CA_BUNDLE=

# Модель по умолчанию (aitunnel: gpt-6-luna, gigachat: GigaChat-2-Pro) и модели по агентам
POLYMCP_MODEL=
# Например для GigaChat: planner=GigaChat-2-Max,*=GigaChat-2
POLYMCP_MODELS=
POLYMCP_LLM_TIMEOUT=60
# Уровень рассуждений по агентам (planner, synthesizer, executor, condenser, critic, baseline; * — остальные).
# Пусто — по умолчанию (aitunnel: planner=minimal,*=none; gigachat: не отправляется); off — не отправлять.
POLYMCP_REASONING=
# Сколько запросов к модели одновременно (0 — без ограничения; для gigachat по умолчанию 1)
POLYMCP_MAX_CONCURRENCY=

# MCP-серверы
DATABASE_URL=postgresql://polymcp:polymcp@localhost:5432/polymcp
SHELL_SANDBOX_ROOT=sandbox
# Путь к бинарнику github-mcp-server (https://github.com/github/github-mcp-server/releases)
GITHUB_MCP_BIN=github-mcp-server
GITHUB_PERSONAL_ACCESS_TOKEN=
