# LLM через aitunnel (OpenAI-совместимый API)
AITUNNEL_API_KEY=your_aitunnel_key
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1/
POLYMCP_MODEL=gpt-6-luna
POLYMCP_LLM_TIMEOUT=60
# Уровень рассуждений модели по агентам (planner, synthesizer, executor, condenser, critic, baseline; * — остальные).
# Пустое значение — параметр не отправляется (нужно для провайдеров без reasoning_effort).
POLYMCP_REASONING=planner=minimal,*=none

# MCP-серверы
DATABASE_URL=postgresql://polymcp:polymcp@localhost:5432/polymcp
SHELL_SANDBOX_ROOT=sandbox
# Путь к бинарнику github-mcp-server (https://github.com/github/github-mcp-server/releases)
GITHUB_MCP_BIN=github-mcp-server
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token
